{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "ES2020"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"isolatedModules": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["chrome", "vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "manifest.config.ts"]
}
